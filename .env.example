# Copy to .env (git-ignored) and fill in. Never commit .env.

# Local inference. From WSL with mirrored networking this reaches Windows-hosted Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional hosted provider. Leave the key blank to stay local-only.
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_LIMIT_USD=10
